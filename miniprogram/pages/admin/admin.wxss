page { background: linear-gradient(180deg, #f4f7f9 0%, #edf3ff 100%); color: #333; }
.container { padding: 30rpx; }
.header { font-size: 40rpx; font-weight: bold; margin-bottom: 40rpx; text-align: center; }

.card {
  background: #fff;
  border-radius: 20rpx;
  width: calc(100% - 60rpx);
  padding: 40rpx 30rpx;
  margin-bottom: 40rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.05);
}

.card-title {
  font-size: 34rpx;
  font-weight: bold;
  margin-bottom: 30rpx;
  border-left: 8rpx solid #07c160;
  padding-left: 20rpx;
}

.form-item { display: flex; align-items: center; margin-bottom: 30rpx; }
.form-item .label { width: 160rpx; font-size: 30rpx; color: #666; font-weight: bold; }

.picker-box {
  background: #f8f9fa;
  height: 70rpx;
  line-height: 70rpx;
  padding: 0 24rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #333;
  border: 2rpx solid #e0e0e0;
  margin-right: 20rpx;
  min-width: 140rpx;
  text-align: center;
}

.picker-box:active {
  background: #eef0f2;
  border-color: #07c160;
}

.btn-save {
  background: #07c160;
  color: #fff;
  border-radius: 40rpx;
  font-size: 30rpx;
  height: 80rpx;
  line-height: 80rpx;
  margin-top: 20rpx;
}

.draw-setting {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
  padding: 18rpx 20rpx;
  background: #f8f9fa;
  border-radius: 12rpx;
}

.draw-label { font-size: 30rpx; font-weight: bold; }

.draw-count-input {
  width: 130rpx;
  text-align: center;
  border: 2rpx solid #ddd;
  border-radius: 10rpx;
  height: 60rpx;
  font-size: 32rpx;
  background: #fff;
}

.table-header {
  display: flex;
  background: #f0f2f5;
  padding: 20rpx 10rpx;
  border-radius: 10rpx;
  font-size: 24rpx;
  color: #666;
  font-weight: bold;
}

.table-row {
  display: flex;
  align-items: center;
  padding: 18rpx 10rpx;
  border-bottom: 2rpx solid #f0f0f0;
  font-size: 24rpx;
}

.th, .td { text-align: center; }
.th.name, .td.name { flex: 1.25; }
.th.status, .td.status { flex: 0.9; }
.th.reg, .td.reg { flex: 0.8; }
.th.pool, .td.pool { flex: 1.0; }
.th.weight, .weight-input { flex: 0.9; }
.th.action, .btn-update { flex: 0.9; }

.td.name { font-weight: bold; }
.td.status.bound { color: #07c160; }
.td.status.empty { color: #aaa; }

.td.reg { font-size: 24rpx; font-weight: bold; }
.td.reg.reg-yes { color: #ff9800; }
.td.reg.reg-no { color: #ccc; }

.td.pool.pool-on { color: #2a7bfa; font-weight: 600; }
.td.pool.pool-off { color: #bbb; }

.weight-input {
  background: #f8f9fa;
  height: 56rpx;
  width: 90rpx;
  text-align: center;
  border-radius: 8rpx;
  margin: 0 auto;
  border: 2rpx solid #ddd;
}

.btn-update {
  font-size: 22rpx;
  background: #e0f7fa;
  color: #00acc1;
  padding: 0 12rpx;
  height: 50rpx;
  line-height: 50rpx;
  border-radius: 25rpx;
  margin: 0;
}

.pool-help { color:#666; font-size:24rpx; margin-bottom:16rpx; }
.pool-textarea { width:100%; min-height:220rpx; border:2rpx solid #ddd; border-radius:12rpx; background:#fafafa; padding:20rpx; box-sizing:border-box; font-size:28rpx; margin-bottom:20rpx; }
