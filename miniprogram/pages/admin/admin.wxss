page { background: #f4f7f9; color: #333; }
.container { padding: 30rpx; }
.header { font-size: 40rpx; font-weight: bold; margin-bottom: 40rpx; text-align: center; }

.card { background: #fff; border-radius: 20rpx; width: calc(100% - 60rpx); padding: 40rpx 30rpx; margin-bottom: 40rpx; box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.03); }

.card-title { font-size: 34rpx; font-weight: bold; margin-bottom: 30rpx; border-left: 8rpx solid #07c160; padding-left: 20rpx; }

/* 时间表单 */
/* 修改后的时间选择器样式 */
.form-item { display: flex; align-items: center; margin-bottom: 30rpx; }
.form-item .label { width: 160rpx; font-size: 30rpx; color: #666; font-weight: bold;}

.picker-box { 
  background: #f8f9fa; 
  height: 70rpx; 
  line-height: 70rpx; 
  padding: 0 24rpx; 
  border-radius: 12rpx; 
  font-size: 28rpx; 
  color: #333;
  border: 2rpx solid #e0e0e0;
  margin-right: 20rpx;
  min-width: 140rpx;
  text-align: center;
  transition: all 0.2s;
}

.picker-box:active {
  background: #eef0f2;
  border-color: #07c160;
}
.btn-save { background: #07c160; color: #fff; border-radius: 40rpx; font-size: 30rpx; height: 80rpx; line-height: 80rpx; margin-top: 20rpx; }

/* 数据表格 */
.table-header { display: flex; background: #f0f2f5; padding: 20rpx; border-radius: 10rpx; font-size: 26rpx; color: #666; font-weight: bold; }
.table-row { display: flex; align-items: center; padding: 20rpx; border-bottom: 2rpx solid #f0f0f0; font-size: 26rpx; }
.th, .td { flex: 1; text-align: center; }

.td.name { font-weight: bold; }
.td.status.bound { color: #07c160; }
.td.status.empty { color: #aaa; }

.weight-input { background: #f8f9fa; height: 60rpx; width: 100rpx; text-align: center; border-radius: 8rpx; margin: 0 auto; border: 2rpx solid #ddd; }
.btn-update { font-size: 24rpx; background: #e0f7fa; color: #00acc1; padding: 0 20rpx; height: 50rpx; line-height: 50rpx; border-radius: 25rpx; margin: 0;}

/* 新增：报名状态列的样式 */
.td.reg { font-size: 24rpx; font-weight: bold; }
.td.reg.reg-yes { color: #ff9800; } /* 报名的给个显眼的橘色 */
.td.reg.reg-no { color: #ccc; }    /* 没报名的低调点 */