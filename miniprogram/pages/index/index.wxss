page {
  background: linear-gradient(180deg, #f4f7f9 0%, #eef5ff 100%);
  font-family: -apple-system, sans-serif;
}

.container {
  padding: 40rpx;
  position: relative;
  padding-top: 80rpx;
}

.card {
  background: #fff;
  padding: 72rpx 50rpx;
  border-radius: 24rpx;
  text-align: center;
  margin-top: 100rpx;
  box-shadow: 0 12rpx 30rpx rgba(0, 0, 0, 0.06);
}

.title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.sub-text {
  color: #888;
  font-size: 28rpx;
  margin: 30rpx 0 10rpx;
}

.picker-box {
  background: #f8f9fa;
  border: 2rpx solid #eaeaea;
  padding: 30rpx;
  border-radius: 12rpx;
  margin: 40rpx 0 60rpx;
  text-align: left;
}

.picker-label {
  color: #666;
  font-size: 30rpx;
}

.picker-value {
  color: #999;
  font-size: 30rpx;
  font-weight: bold;
}

.picker-value.active {
  color: #07c160;
}

.btn {
  border-radius: 50rpx;
  height: 90rpx;
  line-height: 90rpx;
  font-size: 32rpx;
}

.btn-secondary {
  background: #eef2f6;
  color: #3d4b5f;
}

.desc {
  font-size: 32rpx;
  color: #666;
  margin-top: 30rpx;
}

.highlight {
  color: #07c160;
  font-weight: bold;
  font-size: 36rpx;
}

.pool-tag {
  margin: 24rpx auto;
  display: inline-block;
  padding: 12rpx 24rpx;
  border-radius: 28rpx;
  font-size: 28rpx;
  color: #0b8a5a;
  background: #e8f8ee;
  border: 2rpx solid #bfe8cf;
}

.admin-entry {
  position: fixed;
  bottom: 60rpx;
  right: 40rpx;
  background: rgba(0, 0, 0, 0.65);
  color: white;
  padding: 16rpx 30rpx;
  border-radius: 40rpx;
  font-size: 26rpx;
  box-shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.2);
  z-index: 999;
}

.admin-entry:active {
  background: rgba(0, 0, 0, 0.9);
}

.time-board {
  background: #f8f9fa;
  padding: 30rpx;
  border-radius: 16rpx;
  margin: 40rpx 0;
  border: 2rpx dashed #dcdfe6;
}

.time-label {
  font-size: 26rpx;
  color: #888;
  margin-bottom: 10rpx;
}

.time-value {
  font-size: 30rpx;
  color: #333;
  font-weight: bold;
}

.status-badge {
  display: inline-block;
  padding: 8rpx 24rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
  font-weight: bold;
  margin-bottom: 30rpx;
}

.status-badge.warning {
  background: #fff3e0;
  color: #ff9800;
}

.status-badge.danger {
  background: #ffebee;
  color: #f44336;
}

.btn.disabled {
  background: #e0e0e0;
  color: #9e9e9e;
  box-shadow: none;
}

.refresh-btn {
  position: absolute;
  top: 30rpx;
  right: 40rpx;
  font-size: 26rpx;
  color: #576b95;
  display: flex;
  align-items: center;
  padding: 10rpx;
  z-index: 10;
}

.refresh-btn:active {
  opacity: 0.6;
}
