page {
  background: #f4f7f9;
  font-family: -apple-system, sans-serif;
}

.container {
  padding: 40rpx;
}

.card {
  background: #fff;
  padding: 80rpx 50rpx;
  border-radius: 24rpx;
  text-align: center;
  margin-top: 100rpx;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.04);
}

.title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.sub-text {
  color: #888;
  font-size: 28rpx;
  margin-bottom: 60rpx;
}

.picker-box {
  background: #f8f9fa;
  border: 2rpx solid #eaeaea;
  padding: 30rpx;
  border-radius: 12rpx;
  margin: 40rpx 0 60rpx;
  text-align: left;
}

.picker-label {
  color: #666;
  font-size: 30rpx;
}

.picker-value {
  color: #999;
  font-size: 30rpx;
  font-weight: bold;
}
.picker-value.active {
  color: #07c160;
}

.btn {
  border-radius: 50rpx;
  height: 90rpx;
  line-height: 90rpx;
  font-size: 32rpx;
}

.desc {
  font-size: 32rpx;
  color: #666;
  margin-top: 30rpx;
}

.highlight {
  color: #07c160;
  font-weight: bold;
  font-size: 36rpx;
}

/* 添加到 index.wxss 最底部 */
.admin-entry {
  position: fixed;
  bottom: 60rpx;
  right: 40rpx;
  background: rgba(0, 0, 0, 0.6);
  color: white;
  padding: 16rpx 30rpx;
  border-radius: 40rpx;
  font-size: 26rpx;
  box-shadow: 0 4rpx 10rpx rgba(0,0,0,0.2);
  z-index: 999;
}
.admin-entry:active {
  background: rgba(0, 0, 0, 0.9);
}

/* 时间面板样式 */
.time-board {
  background: #f8f9fa;
  padding: 30rpx;
  border-radius: 16rpx;
  margin: 40rpx 0;
  border: 2rpx dashed #dcdfe6;
}
.time-label { font-size: 26rpx; color: #888; margin-bottom: 10rpx; }
.time-value { font-size: 30rpx; color: #333; font-weight: bold; }

/* 状态徽章 */
.status-badge {
  display: inline-block;
  padding: 8rpx 24rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
  font-weight: bold;
  margin-bottom: 30rpx;
}
.status-badge.warning { background: #fff3e0; color: #ff9800; }
.status-badge.danger { background: #ffebee; color: #f44336; }
.status-badge.success { background: #e8f5e9; color: #4caf50; }

/* 禁用按钮的样式 */
.btn.disabled {
  background: #e0e0e0;
  color: #9e9e9e;
  box-shadow: none;
}

/* 确保容器能作为绝对定位的参照物 */
.container { 
  padding: 40rpx; 
  position: relative; 
  padding-top: 80rpx; /* 给顶部的刷新按钮留出一点空间 */
}

/* 刷新按钮样式 */
.refresh-btn {
  position: absolute;
  top: 30rpx;
  right: 40rpx;
  font-size: 26rpx;
  color: #576b95; /* 微信经典的链接蓝色 */
  display: flex;
  align-items: center;
  padding: 10rpx;
  z-index: 10;
}
.refresh-btn:active {
  opacity: 0.6; /* 点击时稍微变暗一点点，增加反馈感 */
}